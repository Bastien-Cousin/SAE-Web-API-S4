{
  "name": "sae_node_api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --exec tsx ./src/index.ts",
    "build": "rm -rf dist && tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "npm run db:push && npm run db:seed",
    "import:teams": "npx tsx ./src/import_donnees/equipes_cs.ts",
    "import:players": "npx tsx ./src/import_donnees/joueurs_cs.ts",
    "import:matches": "npx tsx ./src/import_donnees/matchs_cs.ts",
    "import:tournament": "npx tsx ./src/import_donnees/tournois_cs.ts",
    "import:all": "npm run import:teams && npm run import:players && npm run import:matches && npm run import:tournament",
    "reset:tournament-urls": "npx tsx ./src/scripts/reset-tournament-urls.ts",
    "download:team-logos": "npx tsx ./src/scripts/download-team-logos.ts",
    "fix:team-urls": "npx tsx ./src/scripts/fix-team-logo-urls.ts",
    "download:tournament-banners": "npx tsx ./src/scripts/download-tournament-banners.ts",
    "fix:tournament-banner-urls": "npx tsx ./src/scripts/fix-tournament-banner-urls.ts",
    "diagnose": "npx tsx ./src/scripts/diagnose-db.ts",
    "download:all": "npm run download:team-logos && npm run fix:team-urls && npm run download:tournament-banners && npm run fix:tournament-banner-urls",
    "setup": "npm run db:migrate && npm run db:generate && npm run db:seed && npm run import:all && npm run download:team-logos && npm run fix:team-urls && npm run download:tournament-assets && npm run fix:tournament-banner-urls && npm run reset:tournament-urls"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.5.0",
    "axios": "^1.13.6",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.12",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.19.37",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/yamljs": "^0.2.34",
    "@vitest/coverage-v8": "^4.1.0",
    "nodemon": "^3.1.14",
    "prisma": "^7.5.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
