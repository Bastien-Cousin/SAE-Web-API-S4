// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client-js"
    // output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

// Modèle teams (Équipes Counter-Strike)
model team {
    pageid              BigInt    @id
    pagename            String?
    namespace           Int?
    objectname          String    @unique
    name                String?
    locations           Json?
    region              String?
    logo                String?
    logourl             String?
    logodark            String?
    logodarkurl         String?
    textlesslogourl     String?
    textlesslogodarkurl String?
    status              String?
    createdate          DateTime? @db.Date
    disbanddate         DateTime? @db.Date
    earnings            BigInt?
    earningsbyyear      Json?
    template            String?
    links               Json?
    extradata           Json?
    wiki                String?

    // Relations
    players        player[]    @relation("teamplayers")
    matchesAsteam1 match[]     @relation("team1matches")
    matchesAsteam2 match[]     @relation("team2matches")
    matchteams     matchteam[]

    @@map("team")
}

// Modèle players (Joueurs)
model player {
    pageid         BigInt    @id
    pagename       String?
    namespace      Int?
    objectname     String    @unique
    id             String?
    alternateid    String?
    name           String?
    localizedname  String?
    type           String?
    nationality    String?
    nationality2   String?
    nationality3   String?
    region         String?
    birthdate      DateTime? @db.Date
    deathdate      DateTime? @db.Date
    teampagename   String?
    teamtemplate   String?
    links          Json?
    status         String?
    earnings       Int?
    earningsbyyear Json?
    extradata      Json?
    wiki           String?
    team_id        BigInt?

    // Relations
    team         team?         @relation("teamplayers", fields: [team_id], references: [pageid])
    matchplayers matchplayer[]

    @@index([team_id])
    @@map("player")
}

// Modèle matches (matchs)
model match {
    pageid             BigInt    @id
    pagename           String?
    namespace          Int?
    objectname         String?
    match2id           String?
    match2bracketid    String?
    status             String?
    winner             String?
    walkover           String?
    resulttype         String?
    finished           Boolean?  @default(false)
    mode               String?
    type               String?
    section            String?
    game               String?
    patch              String?
    links              Json?
    bestof             Int?
    date               DateTime?
    dateexact          Boolean?  @default(false)
    stream             Json?
    vod                String?
    tournament         String?
    parent             String?
    tickername         String?
    shortname          String?
    series             String?
    icon               String?
    iconurl            String?
    icondark           String?
    icondarkurl        String?
    liquipediatier     String?
    liquipediatiertype String?
    publishertier      String?
    extradata          Json?
    match2bracketdata  Json?
    match2games        Json?
    match2opponents    Json?
    wiki               String?

    // Relations
    team1_id     BigInt?
    team2_id     BigInt?
    team1        team?         @relation("team1matches", fields: [team1_id], references: [pageid])
    team2        team?         @relation("team2matches", fields: [team2_id], references: [pageid])
    matchteams   matchteam[]
    matchplayers matchplayer[]
    predictions  prediction[]

    @@index([team1_id])
    @@index([team2_id])
    @@index([date])
    @@map("match")
}

// Modèle Many-to-Many match-teams
model matchteam {
    match_id BigInt
    team_id  BigInt

    match match @relation(fields: [match_id], references: [pageid], onDelete: Cascade)
    team  team  @relation(fields: [team_id], references: [pageid], onDelete: Cascade)

    @@id([match_id, team_id])
    @@index([team_id])
    @@map("matchteam")
}

// Modèle Many-to-Many match-players
model matchplayer {
    match_id  BigInt
    player_id BigInt

    match  match  @relation(fields: [match_id], references: [pageid], onDelete: Cascade)
    player player @relation(fields: [player_id], references: [pageid], onDelete: Cascade)

    @@id([match_id, player_id])
    @@index([player_id])
    @@map("matchplayer")
}

// Modèle Tournament (Tournois)
model tournament {
    pageid             BigInt    @id
    pagename           String?
    namespace          Int?
    objectname         String    @unique
    name               String?
    shortname          String?
    tickername         String?
    banner             String?
    bannerurl          String?
    bannerdark         String?
    bannerdarkurl      String?
    icon               String?
    iconurl            String?
    icondark           String?
    icondarkurl        String?
    seriespage         String?
    serieslist         Json?
    previous           String?
    previous2          String?
    next               String?
    next2              String?
    game               String?
    mode               String?
    patch              String?
    endpatch           String?
    type               String?
    organizers         String?
    startdate          DateTime? @db.Date
    enddate            DateTime? @db.Date
    sortdate           DateTime? @db.Date
    locations          Json?
    prizepool          BigInt?
    participantsnumber Int?
    liquipediatier     String?
    liquipediatiertype String?
    publishertier      String?
    status             String?
    maps               String?
    format             String?
    sponsors           String?
    extradata          Json?
    wiki               String?

    @@map("tournament")
}

// Modèle User pour gérer les utilisateurs et l'authentification
model User {
    id        Int      @id @default(autoincrement())
    username  String   @unique
    email     String   @unique
    password  String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    predictions prediction[]

    @@map("user")
}

// Modèle Prediction - Prédictions de matchs par utilisateurs
model prediction {
    id       Int    @id @default(autoincrement())
    user_id  Int
    match_id BigInt

    // Prédiction du vainqueur du match (1 ou 2)
    predicted_winner Int

    // Confiance de la prédiction (0-100%)
    confidence Int?

    // Relations
    user             User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
    match            match             @relation(fields: [match_id], references: [pageid], onDelete: Cascade)
    prediction_games prediction_game[]

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    @@unique([user_id, match_id])
    @@index([user_id])
    @@index([match_id])
    @@map("prediction")
}

// Modèle Prediction_Game - Détails des 5 jeux possibles dans une prédiction
model prediction_game {
    id            Int @id @default(autoincrement())
    prediction_id Int
    game_number   Int // 1, 2, 3, 4, 5

    // Map du jeu
    map String? // "Inferno", "Dust2", "Mirage", "Nuke", "Vertigo", "Ancient", "Anubis"

    // Scores prédits pour chaque équipe
    team1_score Int? // Score team1 (ex: 16)
    team2_score Int? // Score team2 (ex: 14)

    // Qui gagne ce jeu (1 ou 2)
    predicted_winner Int?

    // Relation
    prediction prediction @relation(fields: [prediction_id], references: [id], onDelete: Cascade)

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    @@unique([prediction_id, game_number])
    @@map("prediction_game")
}
