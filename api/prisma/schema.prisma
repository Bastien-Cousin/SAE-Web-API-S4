// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Modèle teams (Équipes Counter-Strike)
model team {
    pageid              BigInt    @id
    pagename            String?
    namespace           Int?
    objectname          String    @unique
    name                String?
    locations           Json?
    region              String?
    logo                String?
    logourl             String?
    logodark            String?
    logodarkurl         String?
    textlesslogourl     String?
    textlesslogodarkurl String?
    status              String?
    createdate          DateTime? @db.Date
    disbanddate         DateTime? @db.Date
    earnings            BigInt?
    earningsbyyear      Json?
    template            String?
    links               Json?
    extradata           Json?
    wiki                String?

    // Relations
    players        player[]    @relation("teamplayers")
    matchesAsteam1 match[]     @relation("team1matches")
    matchesAsteam2 match[]     @relation("team2matches")
    matchteams     matchteam[]
}

// Modèle players (Joueurs)
model player {
    pageid         BigInt    @id
    pagename       String?
    namespace      Int?
    objectname     String    @unique
    id             String?
    alternateid    String?
    name           String?
    localizedname  String?
    type           String?
    nationality    String?
    nationality2   String?
    nationality3   String?
    region         String?
    birthdate      DateTime? @db.Date
    deathdate      DateTime? @db.Date
    teampagename   String?
    teamtemplate   String?
    links          Json?
    status         String?
    earnings       Int?
    earningsbyyear Json?
    extradata      Json?
    wiki           String?
    team_id        BigInt?

    // Relations
    team         team?         @relation("teamplayers", fields: [team_id], references: [pageid])
    matchplayers matchplayer[]

    @@index([team_id])
}

// Modèle matches (matchs)
model match {
    pageid             BigInt    @id
    pagename           String?
    namespace          Int?
    objectname         String?
    match2id           String?
    match2bracketid    String?
    status             String?
    winner             String?
    walkover           String?
    resulttype         String?
    finished           Boolean?  @default(false)
    mode               String?
    type               String?
    section            String?
    game               String?
    patch              String?
    links              Json?
    bestof             Int?
    date               DateTime?
    dateexact          Boolean?  @default(false)
    stream             Json?
    vod                String?
    tournament         String?
    parent             String?
    tickername         String?
    shortname          String?
    series             String?
    icon               String?
    iconurl            String?
    icondark           String?
    icondarkurl        String?
    liquipediatier     String?
    liquipediatiertype String?
    publishertier      String?
    extradata          Json?
    match2bracketdata  Json?
    match2games        Json?
    match2opponents    Json?
    wiki               String?

    // Relations
    team1_id     BigInt?
    team2_id     BigInt?
    team1        team?         @relation("team1matches", fields: [team1_id], references: [pageid])
    team2        team?         @relation("team2matches", fields: [team2_id], references: [pageid])
    matchteams   matchteam[]
    matchplayers matchplayer[]

    @@index([team1_id])
    @@index([team2_id])
    @@index([date])
}

// Modèle Many-to-Many match-teams
model matchteam {
    match_id BigInt
    team_id  BigInt

    match match @relation(fields: [match_id], references: [pageid], onDelete: Cascade)
    team  team  @relation(fields: [team_id], references: [pageid], onDelete: Cascade)

    @@id([match_id, team_id])
    @@index([team_id])
}

// Modèle Many-to-Many match-players
model matchplayer {
    match_id  BigInt
    player_id BigInt

    match  match  @relation(fields: [match_id], references: [pageid], onDelete: Cascade)
    player player @relation(fields: [player_id], references: [pageid], onDelete: Cascade)

    @@id([match_id, player_id])
    @@index([player_id])
}

