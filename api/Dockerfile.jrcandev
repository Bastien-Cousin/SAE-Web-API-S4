# I. BUILD
FROM node:20-alpine AS builder

WORKDIR /app

# 1. Dépendances
COPY package*.json ./
RUN npm install

# 2. Schéma Prisma (obligatoire avant generate)
COPY prisma ./prisma
COPY prisma.config.ts ./

# Variable fake juste pour le build
ENV DATABASE_URL="postgresql://user:pass@localhost:5432/db"

# 3. Génération du client Prisma
RUN npx prisma generate

# 4. Code applicatif
COPY tsconfig.json ./
COPY src ./src
COPY swagger.yaml ./

# 5. Compilation des sources pour une version en production
RUN npm run build

# II. RUNTIME
FROM node:20-alpine AS runtime

WORKDIR /app

RUN apk add --no-cache netcat-openbsd

# 1. Dépendances
COPY package*.json ./
RUN npm install --omit=dev

# 2. Récupération des éléments prisma
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma ./node_modules/@prisma
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/prisma.config.ts ./prisma.config.ts

# 3. Récupération du Code applicatif compilé
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/swagger.yaml ./swagger.yaml

RUN ls -la /app

EXPOSE 3070

COPY entrypoint.production.sh /app/entrypoint.production.sh
RUN chmod +x /app/entrypoint.production.sh && \
    sed -i 's/\r$//' /app/entrypoint.production.sh

ENTRYPOINT ["/bin/sh", "/app/entrypoint.production.sh"]