# Local Development Environment Variables
# Override .env with localhost for local development

# Docker Compose
NAME=sae-web-but2-groupe7

# Environment
LOCAL_DEV=1

# PostgreSQL (LOCAL - override db with localhost)
POSTGRES_USER=sae_user
POSTGRES_PASSWORD=sae_password
POSTGRES_DB=sae_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# API
API_PORT=3070
DATABASE_URL=postgresql://sae_user:sae_password@localhost:5432/sae_db?sslmode=disable

